DEEPSEEK_API_KEY=
# The documented Search/Fetch configuration is included. No verification edits needed.
API_CONTRACT=config/api_contract.json
AUDIT_DB=data/audits.sqlite
# Conservative local rate per service; account-wide API limits still apply.
REQUESTS_PER_MINUTE=10
REQUEST_TIMEOUT=30
MAX_REQUESTS=100
CACHE_TTL_HOURS=24
# Optional price overrides (USD per successful non-empty request).
# Blank uses the documented $0.75 per 1,000 successful requests.
SEARCH_COST_PER_REQUEST=
FETCH_COST_PER_REQUEST=
